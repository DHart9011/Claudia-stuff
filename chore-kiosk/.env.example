# Copy this file to .env and fill in real values. .env is gitignored — never
# commit actual secrets or connection strings.

# PostgreSQL connection string (Railway/Render/Neon/Supabase/local Postgres all work).
DATABASE_URL="postgresql://user:password@localhost:5432/chore_kiosk?schema=public"

# Signs the session cookie used for the tap-avatar + PIN login. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Encrypts QuickBooks OAuth tokens at rest (AES-256-GCM, 32 random bytes as hex). Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- QuickBooks Online ---------------------------------------------------
# Not required yet: no integration code calls these. Fill in once you've
# registered an app at https://developer.intuit.com and are ready to wire
# up the payout flow. See README "QuickBooks integration" for the plan.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
